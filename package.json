{
  "name": "playwright-qa-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Public QA automation portfolio: Playwright, API, BDD, visual and CI testing.",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke --project=chromium",
    "test:api": "playwright test --grep @api",
    "test:network": "playwright test --grep @network --project=chromium",
    "test:accessibility": "playwright test --grep @accessibility --project=chromium",
    "test:contract": "playwright test --grep @contract --project=chromium",
    "test:performance": "playwright test --grep @performance --project=chromium",
    "test:security": "playwright test --grep @security --project=chromium",
    "test:session": "playwright test --grep @session --project=chromium",
    "test:project-dependencies": "playwright test -c playwright.auth.config.ts",
    "test:visual": "playwright test --grep @visual --project=chromium",
    "test:mobile": "playwright test tests/mobile --project=\"Mobile Chrome\"",
    "test:cross-browser": "playwright test tests/cross-browser --project=chromium --project=firefox --project=webkit",
    "test:allure": "playwright test --reporter=line,allure-playwright",
    "report": "playwright show-report",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "bdd": "cucumber-js --config tests/bdd/cucumber.js",
    "mocha": "mocha tests/mocha/**/*.spec.js",
    "lint": "tsc --noEmit",
    "verify": "python scripts/verify.py",
    "hooks:install": "python scripts/install_hooks.py",
    "docs:changelog": "python scripts/document.py changelog",
    "docs:decision": "python scripts/document.py decision",
    "publish": "python scripts/publish.py",
    "install:browsers": "playwright install --with-deps"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "1.64.1",
    "ajv": "^8.17.1",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.2",
    "mocha": "^12.0.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
